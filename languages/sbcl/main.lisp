      (let ((st (now-s)) (sz 0) (z 0))
        (dotimes (i n) (setf sz (heap-push h sz (aref input i))))
        (dotimes (i n) (multiple-value-bind (x ns) (heap-pop h sz) (setf sz ns z (logxor z (u32 (+ x i))))))
        (setf c (u32 z) (aref ts r) (- (now-s) st))))
    (let ((m (median7 ts))) (emit "binary_heap" n m (/ (* n 2) m 1d6) c))))

(defun bench-bst ()
  (let* ((n 300000) (keys (make-array n :element-type '(unsigned-byte 32)))
         (left (make-array n :element-type '(signed-byte 32)))
         (right (make-array n :element-type '(signed-byte 32)))
         (input (make-array n :element-type '(unsigned-byte 32)))
         (ts (make-array 7 :element-type 'double-float)) (c 0))
    (dotimes (i n) (setf (aref input i) (mix32 i)))
    (dotimes (r 7)
      (let ((st (now-s)) (root -1))
        (dotimes (i n)
          (let ((key (aref input i)))
            (setf (aref keys i) key (aref left i) -1 (aref right i) -1)
            (if (< root 0) (setf root i)
                (let ((cur root))
                  (loop
                    (if (< key (aref keys cur))
                        (if (< (aref left cur) 0) (progn (setf (aref left cur) i) (return)) (setf cur (aref left cur)))
                        (if (< (aref right cur) 0) (progn (setf (aref right cur) i) (return)) (setf cur (aref right cur)))))))))
        (let ((h 0))
          (loop for i from 0 below n by 3 do
            (let ((key (aref input i)) (cur root))
              (loop while (and (>= cur 0) (/= (aref keys cur) key)) do
                (setf cur (if (< key (aref keys cur)) (aref left cur) (aref right cur))))
              (when (>= cur 0) (setf h (logxor h (1+ cur))))))
          (setf c (u32 h)))
        (setf (aref ts r) (- (now-s) st))))
    (let ((m (median7 ts))) (emit "bst" n m (/ n m 1d6) c))))

(defun bench-trie ()
  (let* ((n 100000) (passes 32) (mx (+ 1 (* n 8)))
         (ch (make-array (* mx 16) :element-type '(signed-byte 32)))
         (term (make-array mx :element-type '(unsigned-byte 8)))
         (words (make-array n :element-type '(unsigned-byte 32)))
         (ts (make-array 7 :element-type 'double-float)) (c 0))
    (dotimes (i n) (setf (aref words i) (mix32 i)))
    (dotimes (r 7)
      (let ((st (now-s))) (fill ch -1) (fill term 0)
        (let ((used 1))
          (dotimes (i n)
            (let ((word (aref words i)) (node 0))
              (loop for sh from 28 downto 0 by 4 do
                (let* ((cc (logand (ash word (- sh)) 15)) (p (+ (* node 16) cc)) (v (aref ch p)))
                  (when (< v 0) (setf v used (aref ch p) used) (incf used))
                  (setf node v)))
              (setf (aref term node) 1)))
          (let ((h used))
            (dotimes (p passes)
              (loop for i from 0 below n by 2 do
                (let ((word (aref words i)) (node 0))
                  (loop for sh from 28 downto 0 by 4 while (>= node 0) do
                    (setf node (aref ch (+ (* node 16) (logand (ash word (- sh)) 15)))))
                  (when (and (>= node 0) (/= (aref term node) 0))
                    (setf h (logxor h (+ node 1 p))))))
            (setf c (u32 h))))
        (setf (aref ts r) (- (now-s) st))))
    (let ((m (median7 ts))) (emit "trie" (* n passes) m (/ (* n passes) m 1d6) c)))))

(defun bench (k)
  (cond
    ((string= k "integer50") (bench-integer))
    ((string= k "json_escape") (bench-json))
    ((string= k "merge_sort") (bench-merge))
    ((string= k "binary_search") (bench-bs))
    ((string= k "prefix_sum") (bench-prefix))
    ((string= k "matrix_mul") (bench-matrix))
    ((string= k "bfs") (bench-bfs))
    ((string= k "dijkstra") (bench-dijkstra))
    ((string= k "union_find") (bench-uf))
    ((string= k "mandelbrot") (bench-mandel))
    ((string= k "dynamic_array") (bench-array))
    ((string= k "linked_list") (bench-list))
    ((string= k "queue_ring") (bench-queue))
    ((string= k "hash_table") (bench-hash))
    ((string= k "binary_heap") (bench-heap))
    ((string= k "bst") (bench-bst))
    ((string= k "trie") (bench-trie))
    (t (error "unknown kernel ~a" k))))
(defun main ()
  (let* ((argv sb-ext:*posix-argv*) (k (if (> (length argv) 1) (second argv) "integer50")))
    (bench k) (sb-ext:exit :code 0)))
