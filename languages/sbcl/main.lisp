(defun merge-sort! (a tmp)
  (let* ((n (length a)) (src a) (dst tmp) (flip nil) (w 1))
    (loop while (< w n) do
      (loop for lo from 0 below n by (* 2 w) do
        (let ((mid (min (+ lo w) n)) (hi (min (+ lo (* 2 w)) n))
              (i lo) (j (min (+ lo w) n)) (k lo))
          (loop while (and (< i mid) (< j hi)) do
            (if (<= (aref src i) (aref src j))
                (progn (setf (aref dst k) (aref src i)) (incf i))
                (progn (setf (aref dst k) (aref src j)) (incf j)))
            (incf k))
          (loop while (< i mid) do (setf (aref dst k) (aref src i)) (incf i) (incf k))
          (loop while (< j hi) do (setf (aref dst k) (aref src j)) (incf j) (incf k))))
      (rotatef src dst) (setf flip (not flip))
      (if (> w (truncate n 2)) (setf w n) (setf w (* 2 w))))
    (when flip (replace a src))))

