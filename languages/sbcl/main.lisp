  (let* ((od (aref hd 0)) (ov (aref hv 0)) (ns (1- sz))
         (xd (aref hd ns)) (xv (aref hv ns)) (i 0))
    (loop
      (let ((l (+ (* i 2) 1)))
        (when (>= l ns) (return))
        (let* ((rr (1+ l)) (c (if (and (< rr ns) (< (aref hd rr) (aref hd l))) rr l)))
          (when (>= (aref hd c) xd) (return))
          (setf (aref hd i) (aref hd c) (aref hv i) (aref hv c) i c))))
    (when (> ns 0) (setf (aref hd i) xd (aref hv i) xv))
    (values od ov ns)))
