(defun json-escape (input output)
  (let ((j 0))
    (setf (aref output j) 34) (incf j)
    (dotimes (i (length input))
      (let ((c (aref input i)))
        (case c
          (34 (setf (aref output j) 92 (aref output (1+ j)) 34) (incf j 2))
          (92 (setf (aref output j) 92 (aref output (1+ j)) 92) (incf j 2))
          (8  (setf (aref output j) 92 (aref output (1+ j)) 98) (incf j 2))
          (12 (setf (aref output j) 92 (aref output (1+ j)) 102) (incf j 2))
          (10 (setf (aref output j) 92 (aref output (1+ j)) 110) (incf j 2))
          (13 (setf (aref output j) 92 (aref output (1+ j)) 114) (incf j 2))
          (9  (setf (aref output j) 92 (aref output (1+ j)) 116) (incf j 2))
          (otherwise
           (if (< c 32)
               (progn
                 (setf (aref output j) 92
                       (aref output (+ j 1)) 117
                       (aref output (+ j 2)) 48
                       (aref output (+ j 3)) 48
                       (aref output (+ j 4)) (aref +hex+ (ash c -4))
                       (aref output (+ j 5)) (aref +hex+ (logand c 15)))
                 (incf j 6))
               (progn (setf (aref output j) c) (incf j)))))))
    (setf (aref output j) 34)
    (1+ j)))

